# Example environment variables for guarantorLens_mission_capstone_BE
# Copy this file to .env and fill in real values before running.

# Application
SECRET_KEY=change-me            # also signs JWT access tokens; use a long random value in prod
DEBUG=True                      # when True, /auth/forgot-password returns the reset_token for testing
FLASK_ENV=development
PORT=8000

# Auth
ACCESS_TOKEN_TTL_MIN=720        # access-token lifetime in minutes (default 12h)
RESET_TOKEN_TTL_MIN=60          # password-reset link lifetime in minutes

# Frontend origin for CORS (set to your Vercel URL in prod; defaults to *)
FRONTEND_ORIGIN=*

# Database (example Postgres URL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Optional: allowed hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Example third-party API keys
#STRIPE_API_KEY=sk_test_...
#SENTRY_DSN=

# Notes:
# - Do NOT commit your real .env to version control.
# - Keep secrets out of the repo; use .env, environment variables, or a secret manager.
